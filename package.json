{
  "name": "leve",
  "version": "1.2.6",
  "description": "leve — 100% Local & Private Image Resizer and Compressor",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "predev": "npm run doctor",
    "doctor": "node scripts/doctor.cjs",
    "build": "tsc && vite build && electron-builder --dir",
    "package:mac": "tsc && vite build && electron-builder --mac",
    "package:mac:arm64": "tsc && vite build && electron-builder --mac --arm64",
    "package:mac:x64": "tsc && vite build && electron-builder --mac --x64",
    "package:win": "tsc && vite build && electron-builder --win",
    "package:win:x64": "tsc && vite build && electron-builder --win --x64",
    "package:win:arm64": "tsc && vite build && electron-builder --win --arm64",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.local.leve",
    "productName": "leve",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "assets/icon.png"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/ffmpeg-static/**/*",
      "**/node_modules/ffprobe-static/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design"
    },
    "dmg": {
      "backgroundColor": "#121624",
      "iconSize": 110,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 510,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 150,
          "y": 340,
          "type": "file",
          "path": "assets/README-If-blocked.txt"
        },
        {
          "x": 510,
          "y": 340,
          "type": "file",
          "path": "assets/Fix-leve.command"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  }
}
